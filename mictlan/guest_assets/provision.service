[Unit]
Description=Antigravity Sandbox - Provisioning de imagen (first-boot, con red)
After=systemd-user-sessions.service
After=network.target

[Service]
Type=oneshot
ExecStart=/opt/sandbox/provision_guest.sh
StandardOutput=journal+console
TimeoutStartSec=1200
RemainAfterExit=no

[Install]
WantedBy=multi-user.target
